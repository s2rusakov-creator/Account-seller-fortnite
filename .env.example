# ---------- Площадки ----------
# Ключ продавца GameBoost (из их кабинета).
GAMEBOOST_API_KEY=
# Меняйте, только если GameBoost снова переедет: v1 закрыт 30.11.2025 и
# отвечает 410 Gone.
GAMEBOOST_API_BASE=https://api.gameboost.com/v2
GAMEBOOST_CREATE_PATH=/account-offers/create

# GameBoost принимает ссылки на картинки, а не загрузки, поэтому коллаж
# сначала публикуется в Vercel Blob.
#
# На Vercel подключённое хранилище авторизуется через OIDC и само подставляет
# BLOB_READ_WRITE_TOKEN_STORE_ID — токен копировать неоткуда и не нужно.
# В любом другом месте возьмите read-write токен во вкладке .env.local
# хранилища.
BLOB_READ_WRITE_TOKEN=
BLOB_READ_WRITE_TOKEN_STORE_ID=

# Ключ продавца Eldorado (из их кабинета).
ELDORADO_API_KEY=
# Справочник по эндпоинтам Eldorado присылает почтой — оттуда возьмите путь.
ELDORADO_CREATE_PATH=
ELDORADO_API_BASE=https://api.eldorado.gg
ELDORADO_AUTH_HEADER=Authorization
ELDORADO_AUTH_SCHEME=Bearer
ELDORADO_GAME_ID=

# ---------- Данные ----------
# Ключей для чтения раздевалки нет и быть не может: список предметов отдаёт
# только Epic и только владельцу аккаунта, через вход по коду устройства.
# Каталог косметики fortnite-api.com тоже работает без ключа.
#
# То есть без единой переменной окружения приложение читает аккаунты, рисует
# коллажи и выгружает файлы. Ключи нужны ровно для одного — выставить оффер.

# ---------- Доступ ----------
# Ключ подписи входа. Общий с ботом: он выписывает по нему ссылки на /api/auth/link.
# Сгенерировать: openssl rand -hex 32
# Без этой переменной прод не отвечает вообще — так и задумано.
AUTH_SECRET=

# Ключи машин, по одному на потребителя: "метка:ключ" через запятую.
# Метка попадает в заголовок x-caller, поэтому в логах видно, кто вызвал upload.
API_KEYS=bot:

# Токен бота — им проверяется подпись Mini App. Тот же бот, что выдаёт ссылки.
TELEGRAM_BOT_TOKEN=

# Кому разрешено открывать Mini App. Пусто — пускать любого с верной подписью.
TELEGRAM_ALLOWED_IDS=

# Куда сообщать боту об опубликованном объявлении (его /api/notify) и каким ключом.
BOT_NOTIFY_URL=
BOT_NOTIFY_KEY=

# Ограничение частоты запросов: та же база Upstash, что у бота.
# Без них сервис работает, но без ограничения.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
